// LSM303AGR (accelerometer side)
#define LSM303AGR_ACC_ADDR      (0x19 << 1)   // HAL uses 8-bit address
#define CTRL_REG1_A             0x20
#define CTRL_REG4_A             0x23
#define OUT_X_L_A               0x28          // first output register
// Config values: 100 Hz ODR, XYZ enable; BDU=1, HR=1, FS=±2g
#define CTRL1_ODR_100HZ_XYZ_EN  0x57          // ODR=100Hz, X/Y/Z enable
#define CTRL4_BDU_HR_2G         0x88          // BDU=1, HR=1, ±2g
/* USER CODE END Includes */

