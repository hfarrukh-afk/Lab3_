/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* USER CODE BEGIN 1 */
  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */
  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */
  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_LPUART1_UART_Init();
  MX_I2C1_Init();

  /* USER CODE BEGIN 2 */
  // Make stdout unbuffered so prints appear immediately
  setbuf(stdout, NULL);

  printf("\r\nHello from Nucleo-L4R5ZI-P!\r\n");

  // --- Configure LSM303AGR accelerometer: 100 Hz, XYZ enable; BDU=1, HR=1, ±2g ---
  HAL_Delay(10); // short delay after power-up

  uint8_t cfg1 = CTRL1_ODR_100HZ_XYZ_EN; // 0x57
  uint8_t cfg4 = CTRL4_BDU_HR_2G;        // 0x88

  HAL_StatusTypeDef stw1 = HAL_I2C_Mem_Write(&hi2c1, LSM303AGR_ACC_ADDR,
                        CTRL_REG1_A, I2C_MEMADD_SIZE_8BIT, &cfg1, 1, 100);
  HAL_StatusTypeDef stw4 = HAL_I2C_Mem_Write(&hi2c1, LSM303AGR_ACC_ADDR,
                        CTRL_REG4_A, I2C_MEMADD_SIZE_8BIT, &cfg4, 1, 100);

  if (stw1 != HAL_OK || stw4 != HAL_OK) {
    printf("[Accel] Config write failed: st1=%d st4=%d err=0x%lX\r\n",
           stw1, stw4, (unsigned long)HAL_I2C_GetError(&hi2c1));
  } else {
    printf("[Accel] Config done: 100Hz, HR, BDU, ±2g\r\n");
  }

  // Optional: quick WHO_AM_I sanity check (should be 0x33)
  uint8_t who = 0;
  if (HAL_I2C_Mem_Read(&hi2c1, LSM303AGR_ACC_ADDR, 0x0F,
                       I2C_MEMADD_SIZE_8BIT, &who, 1, 100) == HAL_OK) {
    printf("WHO_AM_I_A = 0x%02X (expect 0x33)\r\n\n", who);
  } else {
    printf("WHO_AM_I read failed, err=0x%lX\r\n\n",
           (unsigned long)HAL_I2C_GetError(&hi2c1));
  }
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
    static uint8_t  raw[6];
    static int16_t  rx, ry, rz;
    static const float mg_per_lsb = 0.98f;   // HR ±2g sensitivity (typ) ≈ 0.98 mg/LSB
    static uint32_t last = 0;

    // Burst-read X/Y/Z: auto-increment by OR'ing subaddress with 0x80
    HAL_StatusTypeDef r =
        HAL_I2C_Mem_Read(&hi2c1, LSM303AGR_ACC_ADDR,
                         (OUT_X_L_A | 0x80), I2C_MEMADD_SIZE_8BIT,
                         raw, 6, 100);

    if (r == HAL_OK)
    {
      // L,H pairs; HR mode is 12-bit left-justified → shift right by 4
      rx = (int16_t)((raw[1] << 8) | raw[0]);  rx >>= 4;
      ry = (int16_t)((raw[3] << 8) | raw[2]);  ry >>= 4;
      rz = (int16_t)((raw[5] << 8) | raw[4]);  rz >>= 4;

      float gx = (rx * mg_per_lsb) / 1000.0f;
      float gy = (ry * mg_per_lsb) / 1000.0f;
      float gz = (rz * mg_per_lsb) / 1000.0f;

      // Print at ~10 Hz
      uint32_t now = HAL_GetTick();
      if (now - last >= 100) {
        last = now;
        printf("RAW  X=%6d Y=%6d Z=%6d  |  G  X=%+1.3f Y=%+1.3f Z=%+1.3f\r\n",
               rx, ry, rz, gx, gy, gz);
      }
    }
    else
    {
      printf("I2C read error (accel), err=0x%lX\r\n",
             (unsigned long)HAL_I2C_GetError(&hi2c1));
      HAL_Delay(100);
    }

    HAL_Delay(2); // small pacing
  }
  /* USER CODE END 3 */
}

